# Copia este archivo a .env y ajusta los valores.
#
# --- Base de datos -----------------------------------------------------
# RR-003: la base transaccional es PostgreSQL.
RITECH_DB_URL=postgresql+psycopg://ritch:ritch@localhost:5432/ritch
#
# Para desarrollo local sin servidor PostgreSQL basta SQLite:
# RITECH_DB_URL=sqlite:///./ritch_dev.db
RITECH_SQL_ECHO=false

# --- Seguridad (RNF-001) ----------------------------------------------
# Sustituye esta clave en produccion: minimo 32 bytes.
RITECH_JWT_SECRET=cambia-esta-clave-por-una-de-al-menos-32-bytes
RITECH_JWT_EXPIRE_MINUTES=480

# --- Almacenamiento documental (S3 / Azure Blob) ----------------------
RITECH_UPLOAD_DIR=./uploads
RITECH_MAX_UPLOAD_MB=15

# --- CORS -------------------------------------------------------------
RITECH_CORS_ORIGINS=*
